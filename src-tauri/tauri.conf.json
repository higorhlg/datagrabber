{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Datagrabber",
  "version": "0.1.0",
  "identifier": "dev.higor.datagrabber",
  "build": {
    "frontendDist": "../dist/web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Datagrabber",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self' blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A fast, safe PostgreSQL desktop client",
    "copyright": "Copyright 2026 Higor. Licensed under Apache-2.0."
  }
}
